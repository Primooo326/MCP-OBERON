# Puerto del servidor MCP (por defecto 3001 para no colisionar con Back_360 en 3000)
PORT=3001

# URL base del Backend de Oberon 360 (con prefijo /api)
# Para desarrollo local con Back_360: http://localhost:3000/api
# Para ambiente dev/QA: https://api.dev.oberon360.com/api
# Para ambiente producción: https://api.oberon360.com/api
API_BASE_URL=https://api.dev.oberon360.com/api

# URL base para servir archivos estáticos (descargas de Excel)
LOCAL_URL=http://localhost:3001

# API Key de respaldo / token de autenticación para servicios externos
API_KEY=

# Token para endpoints protegidos por JwtExternalApisGuard (findAllFiltersDav, GPS, etc.)
EXTERNAL_API_KEY=

# URL del servicio de envío de WhatsApp
WHA_API_URL=https://wha.oberon360.com/api/wha/send

# IDs de funcionalidades dinámicas en Oberon (opcional, defaults configurados en código)
# FUNCT_ID_TEMPERATURA=68640ae722068f1bff55f76a
# FUNCT_ID_GPS=68483d789596d9d122f7222a
# FUNCT_ID_VEHICULO=68192b4aa8179b37f7eff226
# FUNCT_ID_SENSOR=68192cc7a8179b37f7f004e6
